{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Monitoring": {
    "NetworkPrefix": "10.130.50.",
    "StartHost": 1,
    "EndHost": 254,
    "ScanIntervalSeconds": 60,
    "PingTimeoutMs": 1000,
    "TcpTimeoutMs": 1000,
    "MaxConcurrency": 32,
    "TcpPorts": [80, 443, 3389, 445],
    "HistoryRetentionDays": 7,
    "ManualScanCooldownSeconds": 30
  },
  "ConnectionStrings": {
    "MonitorDatabase": "Data Source=office-monitor.db"
  },
  "AllowedHosts": "*"
}
